#!/bin/sh
set -eu

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
case "$branch" in
  main)
    echo "Running full realtime gate before pushing main..."
    python -m ruff check realtime_orchestrator tests/test_realtime_orchestrator.py
    python -m pytest -q tests/test_realtime_orchestrator.py
    ;;
esac
