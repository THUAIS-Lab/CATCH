# Copy this file to .env and replace the xxxxx placeholders with your values.
# .env is local-only. Existing environment variables take precedence.

# Shared W&B account and project.
WANDB_ENTITY=xxxxx
WANDB_API_KEY=xxxxx
proj_name=catch_rl

# Shared Lark credentials; logging is disabled by default.
LARK_APP_ID=xxxxx
LARK_APP_SECRET=xxxxx
LARK_OPEN_ID=xxxxx
TRAIN_LARK_SAMPLES=0
VAL_LARK_SAMPLES=0

# Shared storage roots for data-preparation defaults and checkpoint outputs.
DATA_ROOT=xxxxx
CHECKPOINT_ROOT=xxxxx

# Shared DeepCoder SWE v4.1 train/validation parquet files.
DEEPCODER_SWE_V4_1_TRAIN_FILE=xxxxx
DEEPCODER_SWE_V4_1_VAL_FILE=xxxxx

# SFT checkpoints reused by multiple RL recipes.
SFT_N10K_T1K_MODEL_PATH=xxxxx
SFT_N8K_T3K_MODEL_PATH=xxxxx

# Data-conversion API, shared by the preparation scripts.
API_MODEL=qwen3.5-plus
API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
API_KEY=xxxxx

# Monitor API, kept separate from the conversion service as requested.
MONITOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MONITOR_API_KEY=xxxxx

# Runtime settings shared by all retained training scripts.
VLLM_ATTENTION_BACKEND=FLASH_ATTN
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:False"
VLLM_USE_V1=1
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_ENGINE_ITERATION_TIMEOUT_S=1000000000
VLLM_ALLREDUCE_USE_SYMM_MEM=0
RAY_DEBUG_POST_MORTEM=0
